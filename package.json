{
  "name": "widgetforge",
  "version": "0.1.0",
  "description": "Reusable Vue 3 UI framework for window-based widget interfaces in browser and simulation games.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/widgetforge.css"
  },
  "sideEffects": [
    "./dist/widgetforge.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevni92/WidgetForge.git"
  },
  "bugs": {
    "url": "https://github.com/Kevni92/WidgetForge/issues"
  },
  "homepage": "https://kevni92.github.io/WidgetForge/",
  "keywords": [
    "vue",
    "typescript",
    "ui-framework",
    "simulation",
    "widgets",
    "window-manager"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
